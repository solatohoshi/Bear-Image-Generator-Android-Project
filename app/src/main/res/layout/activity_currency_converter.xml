<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CurrencyConvertorActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/CurrencyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/currency_fragmentSection"
        android:layout_width="match_parent"
        android:layout_height="0sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CurrencyToolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:background="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/inputAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/currency_enterAmt"
                    android:textStyle="italic"
                    android:textSize="17sp"
                    app:layout_constraintEnd_toEndOf="@+id/CurrencyAmtTxt"
                    app:layout_constraintStart_toStartOf="@+id/CurrencyAmtTxt"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/CurrencyAmtTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="16dp"
                    android:hint="@string/currency_inputAmt"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@+id/spinnerFromUnit"
                    app:layout_constraintStart_toEndOf="@+id/spinnerFromUnit"
                    app:layout_constraintTop_toBottomOf="@+id/inputAmount" />

                <TextView
                    android:id="@+id/CurrencyResultAmt"
                    android:layout_width="90dp"
                    android:layout_height="22dp"
                    android:layout_marginBottom="57dp"
                    android:text="@string/currency_resultAmt"
                    android:textSize="19sp"
                    app:layout_constraintBottom_toTopOf="@+id/CurrencyAddlist"
                    app:layout_constraintEnd_toEndOf="@+id/CurrencyAmtTxt"
                    app:layout_constraintStart_toStartOf="@+id/CurrencyAmtTxt"
                    app:layout_constraintTop_toTopOf="@+id/spinnerToUnit" />

                <Button
                    android:id="@+id/CurrencyConvertButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:minHeight="30dip"
                    android:text="@string/currency_convertBtn"
                    android:backgroundTint="@color/flight_tracker_primary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.277"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/CurrencyResultAmt"
                    app:layout_constraintVertical_bias="0.64" />

                <Spinner
                    android:id="@+id/spinnerFromUnit"
                    android:layout_width="150sp"
                    android:layout_height="30sp"
                    android:layout_marginStart="64dp"
                    android:layout_marginTop="60dp"
                    android:background="@drawable/bg_spinner_currency"
                    android:spinnerMode="dropdown"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Spinner
                    android:id="@+id/spinnerToUnit"
                    android:background="@drawable/bg_spinner_currency"
                    android:layout_width="150sp"
                    android:layout_height="30sp"
                    android:layout_marginStart="64dp"
                    android:layout_marginTop="64dp"
                    android:spinnerMode="dropdown"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/spinnerFromUnit" />

                <Button
                    android:id="@+id/CurrencyAddlist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="64dp"
                    android:minHeight="30dip"
                    android:backgroundTint="@color/flight_tracker_primary"
                    android:text="@string/currency_resultBtn"
                    app:layout_constraintBottom_toBottomOf="@+id/CurrencyConvertButton"
                    app:layout_constraintStart_toEndOf="@+id/CurrencyConvertButton"
                    app:layout_constraintTop_toTopOf="@+id/CurrencyConvertButton" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="51dp"
                    android:layout_height="45dp"
                    app:layout_constraintBottom_toTopOf="@+id/spinnerToUnit"
                    app:layout_constraintEnd_toEndOf="@+id/spinnerFromUnit"
                    app:layout_constraintStart_toStartOf="@+id/spinnerFromUnit"
                    app:layout_constraintTop_toBottomOf="@+id/spinnerFromUnit"
                    app:srcCompat="@drawable/currency_arrow_exchange" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/CurrencyRecyclerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>